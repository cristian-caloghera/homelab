services:
  server:
    image: docker.gitea.com/gitea:latest
    container_name: gitea
    environment:
      - USER_UID=10001
      - USER_GID=10001
      - GITEA__security__INSTALL_LOCK=true
    restart: always
    networks:
      - reverse_proxy_net
    volumes:
      - gitea:/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "3003:3000"
      - "222:22"

networks:
  reverse_proxy_net:
    external: false

volumes:
  gitea:
    driver: local
    driver_opts:
      type: nfs
      o: addr={{ nfs_server }},rw,vers=4.2
      device: "{{ nfs_path }}"