services:
  mumble-server:
    image: mumblevoip/mumble-server:latest
    container_name: mumble-server
    hostname: mumble-server
    restart: unless-stopped
    ports:
      - 64738:64738
      - 64738:64738/udp
    environment:
      - PUID=10001
      - PGID=10001
      - MUMBLE_CHOWN_DATA=false
      - MUMBLE_CONFIG_sslCert=/acme.sh/mumble.burunet.dedyn.io_ecc/mumble.burunet.dedyn.io.cer
      - MUMBLE_CONFIG_sslKey=/acme.sh/mumble.burunet.dedyn.io_ecc/mumble.burunet.dedyn.io.key
      - MUMBLE_CONFIG_sslCA=/acme.sh/mumble.burunet.dedyn.io_ecc/ca.cer
      - MUMBLE_CONFIG_certrequired=true
      - MUMBLE_CONFIG_serverpassword={{ mumble_server_password }}
    volumes:
      - type: volume
        source: mumble-data
        target: /data
        volume:
          nocopy: true
      - ./acmeout:/acme.sh:ro
  acme.sh:
    image: neilpang/acme.sh
    container_name: acme.sh
    volumes:
      - ./acmeout:/acme.sh
    network_mode: host
    command: daemon
    restart: unless-stopped

volumes:
  mumble-data:
    driver: local
    driver_opts:
      type: nfs
      o: addr={{ nfs_server }},rw,vers=4.2
      device: "{{ nfs_path }}"
# important stuff
# to reload mumble ssl info, execute: kill -10 1
# this is equivalent to: https://wiki.archlinux.org/title/Mumble#SSL/TLS

# to execute it inside the docker container:
# docker exec -it <container> sh

# set various other configs, like supervisor password and limits

# also: https://github.com/acmesh-official/acme.sh/wiki/deploy-to-docker-containers

# acme.sh: deploy to docker does *not* seem to work at all
# also forthe annoying cert key as 0600 root:root
# --post-hook 'chown 1000:1000 ${CERT_KEY_PATH}'
# https://github.com/acmesh-official/acme.sh/issues/5333

# to get cert via acme.sh
# 1. register with zerossl as CA provider
#       sudo docker exec .it acme.sh acme.sh  --register-account  -m myemail@example.com --server zerossl 
# 2. use acme.sh to issue a cert via DNS challenge by desec.io
#       export DEDYN_TOKEN=<...>     # this will be saved in the config
#       sudo docker exec .it acme.sh acme.sh --issue --dns dns_desec -d foobar.dedyn.io -d *.foobar.dedyn.io