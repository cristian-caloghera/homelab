services:
# -----------------------------------------
  banane:
    extends:
      file: ./compose.base.yaml
      service: mc-server
    volumes:
      - ./banane:/data
    networks:
      - banane
    ports:
      - 19132:19132/udp
      - 25565:25565
    environment:
      MOTD: "The Banane Server"
  banane-backup:
    extends:
      file: ./compose.base.yaml
      service: mc-backup
    depends_on:
      banane:
        condition: service_healthy
    environment:
      RCON_HOST: banane
      BACKUP_NAME: banane
    volumes:
      - ./banane:/data:ro
    networks:
      - banane
# -----------------------------------------
  stolen-heart:
    extends:
      file: ./compose.base.yaml
      service: mc-server
    volumes:
      - ./stolen-heart:/data
    networks:
      - stolen-heart
    ports:
      - 19133:19132/udp
      - 25566:25565
    environment:
      MOTD: "The Stolen Heart Server"
  stolen-heart-backup:
    extends:
      file: ./compose.base.yaml
      service: mc-backup
    depends_on:
      stolen-heart:
        condition: service_healthy
    environment:
      RCON_HOST: stolen-heart
      BACKUP_NAME: stolen-heart
    volumes:
      - ./stolen-heart:/data:ro
    networks:
      - stolen-heart

networks:
  banane:
  stolen-heart:

volumes:
  mc-fabric-backups:
    driver: local
    driver_opts:
      type: nfs
      o: addr={{ nfs_server }},rw,vers=4.2
      device: "{{ nfs_path }}"